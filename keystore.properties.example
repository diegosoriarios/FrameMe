# Copy this file to `keystore.properties` for SIGNED LOCAL RELEASE BUILDS.
# `keystore.properties` is git-ignored and must never be committed.
#
# CI does not read this file: the GitHub Actions release workflow passes the
# same values through repository secrets (see the README release section).
storeFile=/absolute/path/to/frameme-release.jks
storePassword=change-me
keyAlias=frameme
keyPassword=change-me
